    {
      "dot": "cyan",
      "title": "交互层",
      "items": [
        "Web UI 只监听 127.0.0.1，单机自用",
        "审核编辑台：AI 稿可改、显示理解依据与推荐理由",
        "任务看板：状态时间线 + 失败截图 + 一键重试"
      ]
    },
    {
      "dot": "emerald",
      "title": "智能层（Provider 可替换）",
      "items": [
        "ASR：默认本地 faster-whisper，口音/专业词多时切云",
        "视觉：场景切分取关键帧（≤24 帧）→ 多模态描述 + 画面 OCR",
        "生成：强制 JSON Schema，字数/违禁词硬校验，不通过自动重写"
      ]
    },
    {
      "dot": "violet",
      "title": "合集匹配（本项目核心增量）",
      "items": [
        "合集清单每日同步 + 发布前刷新一次",
        "召回 top5 → 语义打分 → 阈值决策",
        "≥0.75 自动选中 / 0.55–0.75 待你确认 / 更低则不选"
      ]
    },
    {
      "dot": "amber",
      "title": "发布执行与定时",
      "items": [
        "原子步骤 + 多候选选择器回退，每步可截图重试",
        "URL 跳转 + 笔记列表双重校验，消除「假成功」",
        "幂等键防重复发布；定时默认走平台原生（1h–14d）"
      ]
    },
    {
      "dot": "rose",
      "title": "风控与合规默认值",
      "items": [
        "默认必须人工确认后才提交，不静默发布",
        "每日 ≤2 条、间隔 ≥120 分钟（带随机抖动）",
        "遇验证码/平台提示立即停下交人工；不做点赞收藏评论自动化"
      ]
    }
  ]
